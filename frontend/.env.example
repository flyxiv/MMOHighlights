# Where the FastAPI backend listens. /api/* is proxied there by next.config.ts (read at build/start time).
BACKEND_URL=http://localhost:8000

# 1 = serve in-memory fixtures (lib/mocks.ts) instead of calling the backend.
NEXT_PUBLIC_USE_MOCKS=0

# Optional: connect EventSource straight to the backend (needs CORS) if a proxy buffers /api/events.
# NEXT_PUBLIC_EVENTS_URL=http://localhost:8000/api/events
