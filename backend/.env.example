# Copy to .env for local development.
DATABASE_URL=postgresql+asyncpg://recorder:recorder@localhost:5432/recorder

# Where recordings go. "local" copies into ./local-bucket instead (no credentials needed).
STORAGE_BACKEND=gcs
GCS_BUCKET=mmohighlights
GCS_PREFIX=archives/
# Service-account key for the bucket's project. Not needed on a GCE VM whose service account has access.
GOOGLE_APPLICATION_CREDENTIALS=

SPOOL_DIR=./spool

# Twitch app credentials (dev.twitch.tv/console → Register Your Application). Required for Twitch channels.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
# Optional: confirms YouTube live status with videos.list (1 quota unit per live check).
YOUTUBE_API_KEY=
# Optional: Naver login cookies, only for age-restricted Chzzk streams.
CHZZK_NID_AUT=
CHZZK_NID_SES=

CORS_ORIGINS=["http://localhost:3000"]
